# Copy this file to .env and fill in your API keys
# cp .env.example .env

# === Required ===

# OpenAI API Key (powers AI Coach and program generation)
OPENAI_API_KEY=your_openai_api_key_here

# === Optional: Pinecone Vector DB (custom knowledge base) ===
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=fitness-knowledge

# === Optional: Cohere (embeddings & reranking for Pinecone) ===
COHERE_API_KEY=your_cohere_api_key_here

# === Optional: Notion Integration (user profile & workout import) ===
NOTION_API_KEY=your_notion_api_key_here
NOTION_CLIENT_DB_ID=your_notion_client_database_id_here
NOTION_WORKOUT_TRACKER_DB_ID=your_notion_workout_tracker_database_id_here

# === Optional: PostgreSQL (cross-device sync) ===
DATABASE_URL=postgresql://user:password@localhost:5432/fbb_coach

# === Server Configuration ===
PORT=3001
VITE_API_URL=http://localhost:3001

# === Production only ===
# NODE_ENV=production
# FRONTEND_URL=https://your-frontend-domain.com
